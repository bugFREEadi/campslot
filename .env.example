# CampusSlot local / Docker runtime
# Copy to .env and adjust. Never commit .env or real secrets.
# Load with: node --env-file=.env scripts/serve-local.ts
# Or: export $(grep -v '^#' .env | xargs) && npm start
#
# This app does NOT use MongoDB, OAuth client secrets, payment APIs,
# email providers, or object storage. Auth is bcrypt + server sessions.
# Hosted Cloudflare Sites/Workers use D1 via .openai/hosting.json (no API keys in .env).

# HTTP listen port (1–65535)
PORT=3000

# Bind address. Use 0.0.0.0 inside Docker/containers.
HOST=127.0.0.1

# Exact browser origin for CSRF checks and Secure cookie decisions.
# Must match what you type in the browser (scheme + host + port, no trailing slash).
# Local default: http://127.0.0.1:3000
# Production example: https://campusslot.example.com
APP_ORIGIN=http://127.0.0.1:3000

# Persistent SQLite file for the standalone Node runtime.
# Mount a durable volume at this path in containers.
DATABASE_PATH=data/campusslot.sqlite

# Optional: target URL for seed/browser smoke scripts only (not required by npm start).
# BASE_URL=http://127.0.0.1:3000

# Optional: show Playwright browser during smoke tests.
# HEADED=1

# --- Cloudflare Workers (own account; not required for local SQLite) ---
# Create a D1 database with: npx wrangler d1 create campusslot-db
# Then after build:worker: node scripts/configure-cloudflare.mjs <DATABASE_ID>
# Do not put Wrangler login tokens or API tokens in this file.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=

# --- OpenAI Sites hosting (optional coursework platform) ---
# Project ID lives in .openai/hosting.json. Short-lived source credentials
# are never stored here; obtain them through the Sites workflow when deploying.
